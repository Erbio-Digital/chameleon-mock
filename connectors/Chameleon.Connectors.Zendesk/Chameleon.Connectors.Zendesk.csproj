<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>Zendesk</Title>
    <PackageId>Chameleon.Mock.Connectors.Zendesk</PackageId>
    <ChameleonConnectorName>zendesk</ChameleonConnectorName>
    <PackageTags>chameleon chameleon-connector chameleon-name:$(ChameleonConnectorName)</PackageTags>
    <Description>Stateful simulator of the Zendesk support API for Chameleon</Description>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chameleon.Sdk\Chameleon.Sdk.csproj" />
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" />
  </ItemGroup>
</Project>
