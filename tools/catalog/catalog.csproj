<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates catalog/connectors.json from a folder of .nupkg files. Not packable, not referenced by the Host.
       It references the Host project to reuse CatalogBuilder (also used by the integration tests). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Chameleon.CatalogTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chameleon.Host\Chameleon.Host.csproj" />
  </ItemGroup>
</Project>
